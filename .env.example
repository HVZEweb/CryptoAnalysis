# =============================================================================
# Crypto AI Predictor + Unified OKX Futures Trading Bot
# Скопируйте в .env и заполните секреты
# =============================================================================

# --- OpenRouter / AI ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=kr/claude-sonnet-4.5
OPENROUTER_FALLBACK_MODELS=kr/claude-haiku-4.5,kr/deepseek-3.2
# Локальный прокси (Kiro/OmniRoute): OMNIROUTE_URL=http://localhost:20128/v1
# SKIP_PREDICTION_QUOTA=true
# ИИ не голосует за направление, только пишет текст объяснения. off — не вызывать его вовсе (быстрее и бесплатно)
# PREDICTION_LLM=off

# --- News Impact Detector (optional) ---
# NEWS_IMPACT_AUTO_START=true
# NEWS_IMPACT_INTERVAL_MS=60000
# NEWS_IMPACT_MODEL=cl/deepseek/deepseek-v4-flash
# NEWS_IMPACT_MAX_AGE_HOURS=3
# NEWS_IMPACT_TELEGRAM_CHANNELS=whale_alert,lookonchain,WuBlockchain,BinanceAnnouncements
# NEWS_IMPACT_TELEGRAM=false
# NEWS_IMPACT_TWITTER=false
# NEWS_IMPACT_ALERTS_ENABLED=true
# NEWS_IMPACT_TELEGRAM_BOT_TOKEN=
# NEWS_IMPACT_TELEGRAM_CHAT_ID=
# NEWS_IMPACT_DISCORD_WEBHOOK=
# NEWS_IMPACT_GENERIC_WEBHOOK=
# CRYPTOPANIC_API_KEY=          # https://cryptopanic.com/developers/api/
# CRYPTOPANIC_API_PLAN=developer # developer | growth | enterprise
# CRYPTOPANIC_POLL_MS=25000
# TWITTER_BEARER_TOKEN=           # https://developer.x.com
# NEWS_IMPACT_TWITTER=false       # явно отключить Twitter

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=crypto_predictor

# --- Auth & billing ---
# Единый вход: один аккаунт на сайте, права по роли.
# Первый зарегистрированный аккаунт становится администратором; ADMIN_EMAILS — всегда админы.
# SITE_PRIVATE=true — сайт только для вошедших (регистрация закрыта, пользователей добавляет админ).
# ALLOW_SIGNUP=true — открыть регистрацию и на закрытом сайте.
SITE_PRIVATE=false
# ADMIN_EMAILS=you@example.com
# ALLOW_SIGNUP=false
PAYMENT_WEBHOOK_SECRET=change_me_webhook_secret

# --- OKX API ---
OKX_API_KEY=your_okx_api_key
OKX_SECRET_KEY=your_okx_secret
OKX_PASSPHRASE=your_okx_passphrase
OKX_DEMO=false
# OKX_DEMO=true + ключи демо-API (OKX → Demo trading → API): каждый сигнал из Telegram открывается и на демо-счёте,
# чтобы сравнить реальное исполнение с расчётом. Реальный счёт код не трогает. Размер позиции:
# OKX_DEMO_NOTIONAL_USD=100
# Зеркало AWS — если www.okx.com не резолвится из Python (Windows/aiohttp)
OKX_REST_BASE=https://aws.okx.com
OKX_WS_URL=wss://wsaws.okx.com:8443/ws/v5/public

# =============================================================================
# Unified Trading Bot (bot/main.py)
# =============================================================================

TRADING_MODE=paper
TRADING_ACTIVE_STRATEGY=meta
TRADING_ENABLED_STRATEGIES=hft_orderbook,quant_scalping,ai_predictor

TRADING_HTTP_HOST=127.0.0.1
TRADING_HTTP_PORT=8765
TRADING_PAPER_BALANCE=1000
TRADING_LEVERAGE=5

TRADING_SCAN_INTERVAL_SEC=30
TRADING_TOP_PAIRS=5
TRADING_UNIVERSE_SIZE=100
TRADING_MIN_VOLUME_USD=200000
TRADING_MAX_VOLUME_USD=20000000

TRADING_MIN_DENSITY_USD=15000
TRADING_ANOMALY_MULTIPLIER=3.0
TRADING_MIN_SPREAD_PCT=0.02
TRADING_MAX_SPREAD_PCT=0.8
TRADING_MIN_SCORE=75
TRADING_MIN_EV_USD=0.05
TRADING_NOTIONAL_USD=25

TRADING_TP_PCT=0.45
TRADING_SL_PCT=0.25
TRADING_TRAILING_PCT=0.20
TRADING_RSI_LOW=35
TRADING_RSI_HIGH=65

TRADING_AI_MIN_CONFIDENCE=60

TRADING_MAKER_FEE_PCT=0.02
TRADING_TAKER_FEE_PCT=0.05
TRADING_SLIPPAGE_PCT=0.03
TRADING_FUNDING_PCT=0.01

TRADING_MAX_RISK_PER_TRADE_PCT=1
TRADING_MAX_DAILY_LOSS_PCT=5
TRADING_MAX_DRAWDOWN_PCT=10
TRADING_MAX_POSITIONS=3
TRADING_EMERGENCY_STOP=false

TRADING_API_MAX_RETRIES=3
TRADING_RATE_LIMIT_COOLDOWN_SEC=2
TRADING_DESYNC_THRESHOLD_PCT=0.15
TRADING_WS_STALE_MS=5000

# BOT_PYTHON=bot\.venv\Scripts\python.exe

# --- ML / Ensemble tuning ---
# ENSEMBLE_SCORE_THRESHOLD=0.12
# ENSEMBLE_DYNAMIC_WEIGHTS=true
# Price predictor models live in models/predictor/*.json — retrain with: npm run predictor:train

# --- Production monitoring & automation ---
# MONITORING_ALERTS_ENABLED=true
# MONITORING_RETRAIN_INTERVAL_DAYS=7
# MONITORING_MIN_TRAIN_SAMPLES=30
# MONITORING_DISCORD_WEBHOOK_URL=
# MONITORING_TELEGRAM_BOT_TOKEN=
# MONITORING_TELEGRAM_CHAT_ID=
# MONITORING_EMAIL_WEBHOOK_URL=

# --- Market data collector (npm run market:collect, every 5 min on the server) ---
# How many of the most liquid USDT perpetuals to track
# MARKET_DATA_TOP=40

# --- Trade signals to Telegram (services/signal-scanner.ts, every 5 min inside the app) ---
# Easiest: connect the bot on the admin page (the token is stored in .cache/telegram.json).
# Or set both here; these take precedence:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# SIGNAL_SCANNER=false
