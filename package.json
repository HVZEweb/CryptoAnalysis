{
  "name": "crypto-ai-predictor",
  "version": "1.0.0",
  "private": true,
    "scripts": {
    "dev": "next dev --turbopack",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:init": "npx tsx scripts/init-db.ts",
    "compare-models": "npx tsx scripts/compare-models.ts",
    "backtest": "npx tsx scripts/backtest.ts",
    "trading:init": "cd bot && .venv\\Scripts\\python.exe -c \"from storage.trades import TradeRepository; TradeRepository()\"",
    "trading:start": "cd bot && .venv\\Scripts\\python.exe main.py",
    "trading:backtest": "cd bot && .venv\\Scripts\\python.exe -m backtest.engine",
    "trading:backtest:all": "cd bot && .venv\\Scripts\\python.exe -m backtest.framework",
    "trading:optimize": "cd bot && .venv\\Scripts\\python.exe -m backtest.run_optimization --scenarios 3000 --runs 3000 --params 60 --timeframe 5m",
    "trading:research": "cd bot && .venv\\Scripts\\python.exe -m research.run_research --offline --bars 0 --timeframe 5m",
    "trading:forensic": "cd bot && .venv\\Scripts\\python.exe -m research.run_forensic --offline --bars 0 --timeframe 5m",
    "trading:alpha-download": "cd bot && .venv\\Scripts\\python.exe -m alpha.download_data --type all --months 12",
    "trading:alpha": "cd bot && .venv\\Scripts\\python.exe -m alpha.run_alpha --bars 0 --timeframe 5m",
    "trading:discovery": "cd bot && .venv\\Scripts\\python.exe -m alpha.run_discovery --bars 0",
    "trading:coverage": "cd bot && .venv\\Scripts\\python.exe -m alpha.run_phase_x --no-discovery",
    "trading:archive": "cd bot && .venv\\Scripts\\python.exe -m alpha.run_archive --skip-l2",
    "trading:phase-x": "cd bot && .venv\\Scripts\\python.exe -m alpha.run_phase_x --bars 0",
    "msb:collect": "cd microstructure_bot && .venv\\Scripts\\python.exe main.py collect",
    "msb:status": "cd microstructure_bot && .venv\\Scripts\\python.exe main.py status",
    "msb:daily": "cd microstructure_bot && .venv\\Scripts\\python.exe main.py daily",
    "msb:weekly": "cd microstructure_bot && .venv\\Scripts\\python.exe main.py weekly",
    "msb:research": "cd microstructure_bot && .venv\\Scripts\\python.exe main.py research",
    "msb:study": "cd microstructure_bot && .venv\\Scripts\\python.exe main.py study",
    "eil:collect": "cd execution_intelligence_lab && .venv\\Scripts\\python.exe main.py collect",
    "eil:status": "cd execution_intelligence_lab && .venv\\Scripts\\python.exe main.py status",
    "eil:study": "cd execution_intelligence_lab && .venv\\Scripts\\python.exe main.py study",
    "eil:scan": "cd execution_intelligence_lab && .venv\\Scripts\\python.exe main.py scan",
    "registry:ingest": "cd microstructure_bot && .venv\\Scripts\\python.exe -m alpha_registry ingest --lab all",
    "registry:list": "cd microstructure_bot && .venv\\Scripts\\python.exe -m alpha_registry list",
    "registry:finalize": "cd microstructure_bot && .venv\\Scripts\\python.exe -m alpha_registry finalize",
    "trading:download-data": "cd bot && .venv\\Scripts\\python.exe -m research.download_ohlcv"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.16.0",
    "lucide-react": "^0.511.0",
    "mysql2": "^3.22.5",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.57.0",
    "redis": "^6.1.0",
    "tailwind-merge": "^3.3.0",
    "technicalindicators": "^3.1.0",
    "zod": "^3.25.51"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.23.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
